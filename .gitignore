# Track everything under the AI directory except secrets and local review reports.
# ai/secrets/ is for local credentials and tokens — never committed.
ai/secrets/
ai/secrets/**
# ai/code-review-reports/ contains session-local peer review artefacts — not committed.
ai/code-review-reports/
ai/code-review-reports/**

# Ignore tmp within the project, which may contain local AI artifacts or scratch files.
tmp/

# Global settings directory — personal files shared across all projects (e.g. about-human.md).
# Git-ignored so contents survive git pull without being committed.
settings/

# Basic principal: 
#   Do not add any project AI files to your project work - no matter which AI assistant you are using.
*   Ignore project-specific AI instruction files
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
GEMINI.md
*.local.md


# Ignore local AI assistant state files
.copilot/
.claude/
.cursor/
.windsurf/
.roo/
.qodo/

# Optional AI assistant rule and config files
.cursorrules
.cursorignore
.windsurfrules
.rooignore
.aider.conf.yml
.aider.input.history

# ignore local prompt or transcript artifacts
prompts-local/
chat-logs/

# ignore local scratch files for AI-assisted work
notes-ai/


# IMPORTANT: Order matters: the negation (!) must come after the ignore rule.

# Ignore everything under GitHub directory ...
.github/* 

# ... except the GitHub Actions workflows, which may contain important AI-related automation and documentation. 
!.github/workflows/**