
# IMPORTANT: Order matters: the negation (!) must come after the ignore rule.

# Ignore everything under the AI directory ...
ai/**

# ... except the policy documents, which are important to track in the repository,
#   and are the most important part of this project.
!ai/ai-policy-*.md
!ai/compliance/
!ai/compliance/**




# Ignore tmp within the project, which may contain local AI artifacts or scratch files.
tmp/

# Central settings directory — personal files shared across all projects (e.g. about-human.md).
# Git-ignored so contents survive git pull without being committed.
settings/

# Basic principal: 
#   Do not add any local AI files to your project work - no matter which AI assistant you are using.
*   Ignore local-only AI instruction files
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
GEMINI.md
*.local.md


# Ignore local AI assistant state files
.copilot/
.claude/
.cursor/
.windsurf/
.roo/
.qodo/

# Optional AI assistant rule and config files
.cursorrules
.cursorignore
.windsurfrules
.rooignore
.aider.conf.yml
.aider.input.history

# ignore local prompt or transcript artifacts
prompts-local/
chat-logs/

# ignore local scratch files for AI-assisted work
notes-ai/


# IMPORTANT: Order matters: the negation (!) must come after the ignore rule.

# Ignore everything under GitHub directory ...
.github/* 

# ... except the GitHub Actions workflows, which may contain important AI-related automation and documentation. 
!.github/workflows/**