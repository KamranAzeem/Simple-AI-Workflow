{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-config-schema.json",
  "config": {
    "line-length": false,
    "single-title": false,
    "first-line-heading": false,
    "no-emphasis-as-heading": false,
    "table-column-style": false,
    "no-duplicate-heading": { "siblings_only": true },
    "code-fence-style": { "style": "backtick" },
    "hr-style": { "style": "---" },
    "proper-names": {
      "names": ["GitHub", "GitLab", "Kubernetes", "PowerShell", "Docker", "Terraform", "JavaScript", "TypeScript", "Linux"],
      "code_blocks": false
    }
  }
}
