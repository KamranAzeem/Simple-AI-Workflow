// Save this file under your project root as .vscode/settings.json
// - `"files.autoSave": "off"` globally
// - `files.patterns` applies `"autoSave": "afterDelay"` with 100ms delay to all files in ai/ directory
// - `files.watcherExclude` disables file watching for ai/ to reduce prompts
// - `files.readonlyInclude` ensures ai/ files are writable
//
// You may need to restart vscode for these changes to take effect.
// --------------------------------------------------------------------------------------------------------

{
  // Auto-approve for ai/ directory files
  
  // Global auto-save off
  "files.autoSave": "off",
  
  // Auto-save for ALL files in ai/ directory and subdirectories
  "files.patterns": {
    "**/ai/**": {
      "autoSave": "afterDelay",
      "autoSaveDelay": 100
    }
  },
  
  // Disable file watcher for ai/ to reduce prompts
  "files.watcherExclude": {
    "**/ai/**": true
  },
  
  // Ensure ai/ files are writable
  "files.readonlyInclude": {
    "**/ai/**": false
  }
}
